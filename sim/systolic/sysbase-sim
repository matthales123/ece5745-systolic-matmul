#-------------------------------------------------------------------------
# Command line processing
#-------------------------------------------------------------------------

class ArgumentParserWithCustomError(argparse.ArgumentParser):
  def error( self, msg = "" ):
    if ( msg ): print("\n ERROR: %s" % msg)
    print("")
    file = open( sys.argv[0] )
    for ( lineno, line ) in enumerate( file ):
      if ( line[0] != '#' ): sys.exit(msg != "")
      if ( (lineno == 2) or (lineno >= 4) ): print( line[1:].rstrip("\n") )

def parse_cmdline():
  p = ArgumentParserWithCustomError( add_help=False )

  # Standard command line arguments

  p.add_argument( "-h", "--help",    action="store_true" )

  # Additional commane line arguments for the simulator

  p.add_argument( "--impl", default="fl",
    choices=["fl","scycle","fixed","var","SIZE"] )

  p.add_argument( "--SIZE", default=3 )

  # p.add_argument( "--input", default="small_pos_pos",
  #   choices=["small_pos_pos"] )
  
  p.add_argument( "--input", default="small_pos_pos",
    choices=["small_pos_pos","large","lomask","himask","lohimask","sparse"] )

  # ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''/\

  p.add_argument( "--trace",     action="store_true" )
  p.add_argument( "--stats",     action="store_true" )
  p.add_argument( "--translate", action="store_true" )
  p.add_argument( "--dump-vcd",  action="store_true" )
  p.add_argument( "--dump-vtb",  action="store_true" )

  opts = p.parse_args()
  if opts.help: p.error()
  return opts

#-------------------------------------------------------------------------
# Main
#-------------------------------------------------------------------------

def main():
  opts = parse_cmdline()

  # Create the input pattern

  inputs  = None

  # ''' LAB TASK '''''''''''''''''''''''''''''''''''''''''''''''''''''''''
  # Use additional if statements to set the inputs appropriately based on
  # the --input command line option.
  # ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''\/
  #:
  #: if opts.input == "small":
  #:   inputs = random_small_msgs
  #:

  if   opts.input == "small_pos_pos":    inputs = small_pos_pos_5x5_1_msgs
  elif opts.input == "large":            inputs = small_pos_pos_5x5_1_msgs
  elif opts.input == "lomask":           inputs = small_pos_pos_5x5_1_msgs
  elif opts.input == "himask":           inputs = small_pos_pos_5x5_1_msgs
  elif opts.input == "lohimask":         inputs = small_pos_pos_5x5_1_msgs
  elif opts.input == "sparse":           inputs = small_pos_pos_5x5_1_msgs

  # ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''/\

  # ninputs = len(inputs[::2])
  ninputs = len(inputs[0])

  # Determine which model to use in the simulator

  model_impl_dict = {
    "fl"     : SysBase,
    "scycle" : SysBase,
    "fixed"  : SysBase,
    "var"    : SysBase,
    "SIZE"   : SysBase,
  }

  # Check if translation is valid

  if opts.translate and opts.impl.startswith("fl"):
    print("\n ERROR: --translate only works with RTL models \n")
    # exit(1)

  # Create test harness (we can reuse the harness from unit testing)

  if opts.impl == "SIZE":
    th = TestHarness( model_impl_dict[ opts.impl ]( SIZE=opts.SIZE ) )
  else:
    th = TestHarness( model_impl_dict[ opts.impl ]() )

  th.set_param( "top.srcA0.construct", msgs=inputs[0] )
  th.set_param( "top.srcB0.construct", msgs=inputs[1] )
  th.set_param( "top.srcA1.construct", msgs=inputs[2] )
  th.set_param( "top.srcB1.construct", msgs=inputs[3] )
  th.set_param( "top.srcA2.construct", msgs=inputs[4] )
  th.set_param( "top.srcB2.construct", msgs=inputs[5] )
  th.set_param( "top.srcA3.construct", msgs=inputs[6] )
  th.set_param( "top.srcB3.construct", msgs=inputs[7] )
  th.set_param( "top.srcA4.construct", msgs=inputs[8] )
  th.set_param( "top.srcB4.construct", msgs=inputs[9] )
  
  th.set_param( "top.sinkA0.construct", msgs=inputs[10] )
  th.set_param( "top.sinkB0.construct", msgs=inputs[11] )
  th.set_param( "top.sinkA1.construct", msgs=inputs[12] )
  th.set_param( "top.sinkB1.construct", msgs=inputs[13] )
  th.set_param( "top.sinkA2.construct", msgs=inputs[14] )
  th.set_param( "top.sinkB2.construct", msgs=inputs[15] )
  th.set_param( "top.sinkA3.construct", msgs=inputs[16] )
  th.set_param( "top.sinkB3.construct", msgs=inputs[17] )
  th.set_param( "top.sinkA4.construct", msgs=inputs[18] )
  th.set_param( "top.sinkB4.construct", msgs=inputs[19] )

  # Create VCD filename
  
  if opts.impl == "SIZE":
    unique_name = f"systolic-{int(opts.SIZE)}x{int(opts.SIZE)}-{opts.input}"
  else:
    unique_name = f"systolic-{opts.impl}-{opts.input}"

  cmdline_opts = {
    'dump_vcd': f"{unique_name}" if opts.dump_vcd else '',
    'dump_vtb': f"{unique_name}" if opts.dump_vtb else '',
    'test_verilog': 'zeros' if opts.translate else '',
  }
  

  # Configure the test harness component

  config_model_with_cmdline_opts( th, cmdline_opts, duts=['pe'] )

  # Apply necessary passes

  th.apply( DefaultPassGroup( linetrace=opts.trace ) )

  # Reset test harness

  th.sim_reset()

  # Run simulation

  while not th.done():
    th.sim_tick()

  # Extra ticks to make VCD easier to read

  th.sim_tick()
  th.sim_tick()
  th.sim_tick()

  # Display statistics

  if opts.stats:
    print( f"num_cycles         = {th.sim_cycle_count()}" )
    print( f"num_cycles_per_macc = {th.sim_cycle_count()/(0.5*ninputs):1.2f}" )

main()
