#-------------------------------------------------------------------------
# Command line processing
#-------------------------------------------------------------------------

class ArgumentParserWithCustomError(argparse.ArgumentParser):
  def error( self, msg = "" ):
    if ( msg ): print("\n ERROR: %s" % msg)
    print("")
    file = open( sys.argv[0] )
    for ( lineno, line ) in enumerate( file ):
      if ( line[0] != '#' ): sys.exit(msg != "")
      if ( (lineno == 2) or (lineno >= 4) ): print( line[1:].rstrip("\n") )

def parse_cmdline():
  p = ArgumentParserWithCustomError( add_help=False )

  # Standard command line arguments

  p.add_argument( "-h", "--help",    action="store_true" )

  # Additional commane line arguments for the simulator

  p.add_argument( "--impl", default="fl",
    choices=["fl","scycle","fixed","var","nstage"] )
  
  # p.add_argument( "--impl", default="macnew",
  #   choices=["macnew"] )

  p.add_argument( "--nstages", default=2 )

  # p.add_argument( "--input", default="small_pos_pos",
  #   choices=["small_pos_pos"] )
  
  p.add_argument( "--input", default="small_pos_pos",
    choices=["small_pos_pos","large","lomask","himask","lohimask","sparse"] )

  # ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''/\

  p.add_argument( "--trace",     action="store_true" )
  p.add_argument( "--stats",     action="store_true" )
  p.add_argument( "--translate", action="store_true" )
  p.add_argument( "--dump-vcd",  action="store_true" )
  p.add_argument( "--dump-vtb",  action="store_true" )

  opts = p.parse_args()
  if opts.help: p.error()
  return opts

#-------------------------------------------------------------------------
# Main
#-------------------------------------------------------------------------

def main():
  opts = parse_cmdline()

  # Create the input pattern

  inputs  = None

  # ''' LAB TASK '''''''''''''''''''''''''''''''''''''''''''''''''''''''''
  # Use additional if statements to set the inputs appropriately based on
  # the --input command line option.
  # ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''\/
  #:
  #: if opts.input == "small":
  #:   inputs = random_small_msgs
  #:

  if   opts.input == "small_pos_pos":    inputs = small_pos_pos_msgs
  elif opts.input == "large":            inputs = small_pos_pos_msgs
  elif opts.input == "lomask":           inputs = small_pos_pos_msgs
  elif opts.input == "himask":           inputs = small_pos_pos_msgs
  elif opts.input == "lohimask":         inputs = small_pos_pos_msgs
  elif opts.input == "sparse":           inputs = small_pos_pos_msgs

  # ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''/\

  # ninputs = len(inputs[::2])
  ninputs = len(inputs[0])

  # Determine which model to use in the simulator

  model_impl_dict = {
    "fl"     : MacNew,
    "scycle" : MacNew,
    "fixed"  : MacNew,
    "var"    : MacNew,
    "nstage" : MacNew,
  }

  # Check if translation is valid

  if opts.translate and opts.impl.startswith("fl"):
    print("\n ERROR: --translate only works with RTL models \n")
    # exit(1)

  # Create test harness (we can reuse the harness from unit testing)

  if opts.impl == "nstage":
    th = TestHarness( model_impl_dict[ opts.impl ]() )
  else:
    th = TestHarness( model_impl_dict[ opts.impl ]() )

  th.set_param( "top.srcA.construct", msgs=inputs[0] )
  th.set_param( "top.srcB.construct", msgs=inputs[1] )
  
  th.set_param( "top.sinkA.construct", msgs=inputs[2] )
  th.set_param( "top.sinkB.construct", msgs=inputs[3] )

  # Create VCD filename
  
  if opts.impl == "nstage":
    unique_name = f"systolic-{int(opts.nstages)}stage-{opts.input}"
  else:
    unique_name = f"systolic-{opts.impl}-{opts.input}"

  cmdline_opts = {
    'dump_vcd': f"{unique_name}" if opts.dump_vcd else '',
    'dump_vtb': f"{unique_name}" if opts.dump_vtb else '',
    'test_verilog': 'zeros' if opts.translate else '',
  }
  

  # Configure the test harness component

  config_model_with_cmdline_opts( th, cmdline_opts, duts=['mac'] )

  # Apply necessary passes

  th.apply( DefaultPassGroup( linetrace=opts.trace ) )

  # Reset test harness

  th.sim_reset()

  # Run simulation

  while not th.done():
    th.sim_tick()

  # Extra ticks to make VCD easier to read

  th.sim_tick()
  th.sim_tick()
  th.sim_tick()

  # Display statistics

  if opts.stats:
    print( f"num_cycles         = {th.sim_cycle_count()}" )
    print( f"num_cycles_per_macc = {th.sim_cycle_count()/(0.5*ninputs):1.2f}" )

main()

